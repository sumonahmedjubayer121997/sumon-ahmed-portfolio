# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# These values are not secret (security comes from firestore.rules / storage.rules).
# Copy to .env.local for development and .env.production for builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Content source for builds: auto (Firestore, falling back to seed) | firestore (required) | seed
# CI should use CONTENT_SOURCE=firestore so placeholder content can never be deployed by accident.
CONTENT_SOURCE=auto
