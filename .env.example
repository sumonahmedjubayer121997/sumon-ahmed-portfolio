# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# These values are not secret (security comes from firestore.rules / storage.rules).
# Copy to .env.local for development and .env.production for builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Content source for builds: auto (Firestore, falling back to seed) | firestore (required) | seed
# CI should use CONTENT_SOURCE=firestore so placeholder content can never be deployed by accident.
CONTENT_SOURCE=auto

# App Check (Firebase AI Logic in /admin): reCAPTCHA Enterprise site key (public).
VITE_RECAPTCHA_SITE_KEY=
# Local development only — put this in .env.development.local (never committed, never in builds):
# VITE_APPCHECK_DEBUG_TOKEN=
# Optional: a separate, billing-free Firebase project for AI (Gemini's free tier excludes billed projects).
# Same keys as VITE_FIREBASE_*; the App Check values above then belong to this project.
# VITE_AI_FIREBASE_API_KEY=
# VITE_AI_FIREBASE_AUTH_DOMAIN=
# VITE_AI_FIREBASE_PROJECT_ID=
# VITE_AI_FIREBASE_STORAGE_BUCKET=
# VITE_AI_FIREBASE_APP_ID=
