{
  "name": "sumon-ahmed-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio of Sumon Ahmed — Data Scientist, AI/LLM Engineer and Software Developer.",
  "scripts": {
    "content:pull": "tsx scripts/content/pull.ts",
    "predev": "tsx scripts/content/pull.ts --mode development && tsx scripts/content/embed.ts",
    "dev": "vite",
    "predev:emu": "tsx scripts/content/pull.ts --mode emulators && tsx scripts/content/embed.ts",
    "dev:emu": "vite --mode emulators",
    "emulators": "node scripts/emulators.mjs --only auth,firestore,storage --export-on-exit ./.emulator-data",
    "emulators:resume": "node scripts/emulators.mjs --only auth,firestore,storage --import ./.emulator-data --export-on-exit",
    "prebuild": "tsx scripts/content/pull.ts --mode production && tsx scripts/content/embed.ts",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "pretypecheck": "tsx scripts/content/pull.ts --mode development && tsx scripts/content/embed.ts",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:embed": "tsx scripts/content/embed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "firebase": "^12.19.0",
    "motion": "^12.43.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "^7.18.4",
    "three": "^0.182.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "satori": "^0.35.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "umap-js": "^1.4.0",
    "vite": "^7.3.6"
  }
}
