{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "portfolio-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "portfolio-dev-emulators",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:emu", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/emulators.mjs", "--only", "auth,firestore,storage"],
      "port": 4000
    }
  ]
}
