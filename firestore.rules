rules_version = '2';

// Content model
// - Content collections are public for *published* documents only: the build
//   pulls them with the ordinary web config, and they are on the website anyway.
//   Drafts (published == false) are visible to admins only.
// - Admins are users with a document at admins/{uid} — created once by hand in
//   the Firebase console (the /admin page shows your UID).
// - messages: the contact form. Anyone may create one, in exactly the shape
//   below; only admins read, triage (status) or delete them.
// - chunks and assistantLogs are written only by Cloud Functions (Admin SDK
//   bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A contact-form message, with the spam checks that work without App Check:
    // an empty honeypot field ("website"), at least 3 s spent filling the form,
    // sane lengths, a real-looking email address, at most 3 links, and a
    // server timestamp (so dates can't be forged).
    function isValidMessage(m) {
      return m.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'status', 'website', 'fillMs', 'page'])
        && m.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status', 'website', 'fillMs'])
        && m.name is string && m.name.size() >= 1 && m.name.size() <= 80
        && m.email is string && m.email.size() <= 200 && m.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && m.message is string && m.message.size() >= 10 && m.message.size() <= 4000
        && !m.message.matches('(?s)(.*https?://.*){4,}')
        && m.status == 'new'
        && m.createdAt == request.time
        && m.website == ''
        && m.fillMs is int && m.fillMs >= 3000
        && (!('page' in m) || (m.page is string && m.page.size() <= 200));
    }

    // Null-safe: reading a document that doesn't exist yields "not found", not an error.
    function readable() {
      return resource == null || resource.data.get('published', false) == true || isAdmin();
    }

    // Content collections
    match /site/{id}       { allow read: if readable(); allow write: if isAdmin(); }
    match /research/{id}   { allow read: if readable(); allow write: if isAdmin(); }
    match /projects/{id}   { allow read: if readable(); allow write: if isAdmin(); }
    match /experience/{id} { allow read: if readable(); allow write: if isAdmin(); }
    match /skills/{id}     { allow read: if readable(); allow write: if isAdmin(); }
    match /posts/{id}      { allow read: if readable(); allow write: if isAdmin(); }

    // A signed-in user may check whether they are an admin; nobody writes here from clients.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Server-only data
    match /chunks/{id}        { allow read, write: if false; }
    match /assistantLogs/{id} { allow read: if isAdmin(); allow write: if false; }

    // Contact form: create-only for visitors; admins read, change the status (new / read / spam) and delete.
    match /messages/{id} {
      allow create: if isValidMessage(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read', 'spam'];
    }
  }
}
